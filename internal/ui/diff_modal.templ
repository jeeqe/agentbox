package ui

import (
	"fmt"
	"strings"
)

type diffLine struct {
	Text  string
	Class string
}

func classifyDiff(patch string) []diffLine {
	lines := strings.Split(patch, "\n")
	if len(lines) == 1 && lines[0] == "" {
		return nil
	}
	out := make([]diffLine, 0, len(lines))
	for _, line := range lines {
		class := "diff-context"
		switch {
		case strings.HasPrefix(line, "diff --git "), strings.HasPrefix(line, "index "), strings.HasPrefix(line, "--- "), strings.HasPrefix(line, "+++ "):
			class = "diff-file"
		case strings.HasPrefix(line, "@@"):
			class = "diff-hunk"
		case strings.HasPrefix(line, "+"):
			class = "diff-add"
		case strings.HasPrefix(line, "-"):
			class = "diff-del"
		}
		out = append(out, diffLine{Text: line, Class: class})
	}
	return out
}

templ DiffModal(task TaskView, patch string) {
	<div class="modal-backdrop" data-diff-modal role="presentation">
		<section class="diff-modal" role="dialog" aria-modal="true" aria-labelledby="diff-title">
			<header class="diff-header">
				<div>
					<p class="eyebrow">WORKTREE DIFF · { task.Agent }</p>
					<h2 id="diff-title">{ task.Branch }</h2>
				</div>
				<button class="modal-close" type="button" data-close-modal aria-label="Close diff">×</button>
			</header>
			<div class="diff-summary">
				@StatusPill(task)
				<span><b class="add">+{ fmt.Sprint(task.Additions) }</b> <b class="del">-{ fmt.Sprint(task.Deletions) }</b> lines</span>
			</div>
			if patch == "" {
				<div class="diff-empty">No committed changes are available for this task yet.</div>
			} else {
				<pre class="diff-code" tabindex="0" aria-label="Unified diff">
					for _, line := range classifyDiff(patch) {
						<span class={ "diff-line " + line.Class }>{ line.Text }</span>
					}
				</pre>
			}
			<footer class="diff-footer">
				<button class="button button-secondary" type="button" data-close-modal>Close</button>
				<button class="button button-quiet" type="button" hx-post={ taskPath(task.ID, "rebase") } hx-target={ "#" + taskID(task.ID) } hx-swap="outerHTML" data-close-modal>Rebase on base</button>
			</footer>
		</section>
	</div>
}
