package ui

import (
	"embed"
	"fmt"
)

// StaticFS contains the dashboard assets. Keeping them beside the templates makes
// the dashboard self-contained when AgentBox is compiled into one binary.
//
//go:embed static/*
var StaticFS embed.FS

// TaskView is the presentation model for a single agent task.
type TaskView struct {
	ID        int64
	RunID     int64
	Agent     string
	Branch    string
	Status    string
	Port      int
	Additions int
	Deletions int
	// Clock is the elapsed time as m:ss.
	Clock string
	// StartedMs and FinishedMs are Unix milliseconds; 0 when not started or still running.
	StartedMs  int64
	FinishedMs int64
	// Detail is the short second line under the status, for example the exit code.
	Detail  string
	Running bool
	Message string
}

// HistoryView is one finished run, shown as a single line under the live runs.
type HistoryView struct {
	Title     string
	Outcome   string
	StartedAt string
}

// RunView is one fan-out or race shown on the dashboard.
type RunView struct {
	ID            int64
	Kind          string
	Prompt        string
	Base          string
	StartedAt     string
	Tasks         []TaskView
	FastestTaskID int64
}

func taskID(id int64) string                  { return fmt.Sprintf("task-card-%d", id) }
func statusID(id int64) string                { return fmt.Sprintf("task-status-%d", id) }
func diffID(id int64) string                  { return fmt.Sprintf("task-diff-%d", id) }
func logID(id int64) string                   { return fmt.Sprintf("task-log-%d", id) }
func taskPath(id int64, action string) string { return fmt.Sprintf("/tasks/%d/%s", id, action) }
func isRunning(status string) bool            { return status == "running" || status == "queued" }
func statusLabel(status string) string {
	switch status {
	case "running", "queued":
		return "Running"
	case "passed":
		return "Tests passed"
	case "failed":
		return "Failed"
	case "conflict":
		return "Merge conflict"
	case "killed":
		return "Stopped"
	case "merged":
		return "Merged"
	case "discarded":
		return "Discarded"
	default:
		return status
	}
}

// laneClass marks the lane that finished first in a race.
func laneClass(fastest bool) string {
	class := "lane"
	if fastest {
		class += " is-first"
	}
	return class
}

templ Layout(title string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/agentbox.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/sse.min.js"></script>
			<script defer src="/static/agentbox.js"></script>
		</head>
		<body>
			@body
		</body>
	</html>
}
