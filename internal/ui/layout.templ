package ui

import (
	"embed"
	"fmt"
	"strings"
)

// StaticFS contains the dashboard assets. Keeping them beside the templates makes
// the dashboard self-contained when AgentBox is compiled into one binary.
//go:embed static/*
var StaticFS embed.FS

// TaskView is the presentation model for a single agent task.
type TaskView struct {
	ID        int64
	RunID     int64
	Agent     string
	Branch    string
	Status    string
	Port      int
	Additions int
	Deletions int
	Duration  string
	Running   bool
	Message   string
}

// RunView is one fan-out or race shown on the dashboard.
type RunView struct {
	ID            int64
	Kind          string
	Prompt        string
	Tasks         []TaskView
	FastestTaskID int64
}

func taskID(id int64) string { return fmt.Sprintf("task-card-%d", id) }
func statusID(id int64) string { return fmt.Sprintf("task-status-%d", id) }
func diffID(id int64) string { return fmt.Sprintf("task-diff-%d", id) }
func logID(id int64) string { return fmt.Sprintf("task-log-%d", id) }
func taskPath(id int64, action string) string { return fmt.Sprintf("/tasks/%d/%s", id, action) }
func isRunning(status string) bool { return status == "running" || status == "queued" }
func statusLabel(status string) string {
	switch status {
	case "running", "queued":
		return "RUNNING"
	case "passed":
		return "TESTS PASSED"
	case "failed":
		return "FAILED"
	case "conflict":
		return "CONFLICT"
	case "killed":
		return "KILLED"
	case "merged":
		return "MERGED"
	case "discarded":
		return "DISCARDED"
	default:
		return strings.ToUpper(status)
	}
}

templ Layout(title string, body templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/agentbox.css"/>
			<link rel="stylesheet" href="/static/agentbox-extra.css"/>
			<script defer src="/static/htmx.min.js"></script>
			<script defer src="/static/alpine.min.js"></script>
			<script defer src="/static/agentbox.js"></script>
		</head>
		<body>
			@body
			<div id="modal-root" aria-live="polite"></div>
		</body>
	</html>
}
